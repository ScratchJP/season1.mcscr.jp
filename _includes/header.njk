
<nav class="navbar navbar-expand-lg bg-body-tertiary py-2">
  <div class="container-fluid">
    <div class="navbar-brand fs-3 fw-bold text-dark px-3 ">
      <a class="text-decoration-none" href="/">
        <img 
          src="/assets/logo/64x64.webp" 
          alt="ScJPマイクラ鯖のロゴ" 
          height="36" 
          class="d-inline-block align-text-top"
          draggable="false"
        />
      </a>
      <select class="form-select form-select-sm w-auto d-inline-block" aria-label="Season I" id="season-select">
        <option value="season2">Season II</option>
        <option value="season1" selected>Season I</option>
      </select>
    </div>

    <button
      class="navbar-toggler"
      type="button" 
      data-bs-toggle="collapse" 
      data-bs-target="#navbarNav" 
      aria-controls="navbarNav" 
      aria-expanded="false" 
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        {% for item in navigation %}
          <li class="nav-item fs-5 fw-bold">
            <a class="nav-link 
              {% if item.exact and page.url == item.url or (not item.exact and page.url.indexOf(item.url) == 0) %}active{% endif %}"
              href="{{ item.url }}" {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
              {{ item.name }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</nav>
<script>
const seasonSelect = document.getElementById('season-select')

seasonSelect.addEventListener('change', event => {
  switch (event.target.value) {
    case "season1": break;
    case "season2": {
      window.location.href = "https://mcscr.jp";
      break;
    }
  }
  event.target.value = "season1"
})
</script>